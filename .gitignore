# ---------------------------------------------------------------------------
# LinkPulse .gitignore
# Rule of thumb: anything generated, machine-specific, or secret stays out.
# ---------------------------------------------------------------------------

# --- Python ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual environments --------------------------------------------------
.venv/
.venv312/
venv/
ENV/
env/
.python-version

# --- Test / coverage artifacts --------------------------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.cache
nosetests.xml

# --- ML artifacts ----------------------------------------------------------
# Trained binaries are rebuilt with `python -m backend.ml.train`.
# Keeping them out of git avoids multi-megabyte, non-diffable commits.
backend/ml/*.joblib
backend/ml/*.pkl
backend/ml/models/
data/raw/
data/*.db
data/*.sqlite
!data/raw/.gitkeep

# --- Node / frontend -------------------------------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/coverage/
*.local

# --- Environment & secrets --------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets.json
config.local.*

# --- Editors / OS -----------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# --- Logs & scratch ---------------------------------------------------------
*.log
logs/
tmp/
scratch/

# --- Packaging / deploy -----------------------------------------------------
.vercel/
.netlify/
render.yaml.bak
