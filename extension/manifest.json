{
  "manifest_version": 3,
  "name": "LinkPulse - Phishing URL Detector",
  "version": "1.0.0",
  "description": "Scan URLs for phishing indicators using ML-powered detection. Get instant risk scores and warnings.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Scan this page for phishing"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
